{
    "name": "survos/flickr-bundle",
    "description": "Symfony bundle that wraps samwilson/phpflickr library",
    "keywords": [
        "symfony",
        "flickr",
        "upload"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1",
        "twig/twig": "^3.4|^4.0",
        "samwilson/phpflickr": "^6.0.2",
        "symfony/console": "^8.1",
        "symfony/cache": "^8.1",
        "survos/kit-bundle": "^2.28",
        "symfony/event-dispatcher": "^8.1",
        "psr/log": "^3.0",
        "ext-curl": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "symfony/browser-kit": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/var-dumper": "^8.1",
        "doctrine/orm": "^2.12 || ^3.3",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Survos\\FlickrBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\FlickrBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M"
    }
}
